
# Lazy-load fnm: defer the expensive `fnm env` call until first use of fnm
export PATH="$HOME/.local/share/fnm/aliases/default/bin:$HOME/.local/share/fnm:$PATH"
_dotfiles_require_cmds "node role" fnm || return
_init_fnm() {
  unfunction fnm
  eval "$(command fnm env --use-on-cd)"
}
fnm() {
  _init_fnm
  fnm "$@"
}
