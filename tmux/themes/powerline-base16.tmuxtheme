# Powerline Theme
# Uses standard ANSI colors (0-15) for compatibility with any terminal palette.
# Powerline glyphs:  (U+E0B0 right arrow),  (U+E0B2 left arrow)

# Status update interval
set -g status-interval 2

# Basic status bar colors (dark bg, light fg)
set -g status-style 'fg=colour7,bg=colour0'

# Left side of status bar
set -g status-left-style 'bg=default,fg=default'
set -g status-left-length 150
set -g status-left "#[fg=#{@host_fg},bg=#{@host_bg},bold] #h #[fg=#{@host_bg},bg=colour8,nobold]#[fg=colour7,bg=colour8] #S #[fg=colour8,bg=default]"

# Right side of status bar
set -g status-right-style 'bg=default,fg=default'
set -g status-right-length 150
set -g status-right "#[fg=colour8,bg=colour0]#[fg=colour7,bg=colour8] %Y-%m-%d %I:%M %p "

# Window status
set -g window-status-format "#[fg=colour8,bg=colour0]#{?#{window_activity_flag},, }#[fg=colour7,bg=#{?#{window_activity_flag},colour8,colour0}]#I:#{?#W,#W,#h}#[fg=colour8,bg=colour0]#{?#{window_activity_flag},, }"
set -g window-status-current-format "#[fg=#{@host_bg},bg=colour0]#[fg=#{@host_fg},bg=#{@host_bg},bold]#I:#{?#W,#W,#{?#{b:pane_current_path},#{b:pane_current_path},#h}}#[fg=#{@host_bg},bg=colour0,nobold]#[default]"

# Current window status
set -g window-status-current-style 'bg=default,fg=default'

# Window with activity status
set -g window-status-activity-style 'bg=default,fg=default'
set -g window-status-last-style 'underscore'

# Window separator
set -g window-status-separator ""

# Window status alignment
set -g status-justify centre

# Pane border
set -g pane-border-style 'bg=default,fg=colour8'

# Active pane border
set -g pane-active-border-style 'bg=default,fg=colour4'

# Pane number indicator
set -g display-panes-colour default
set -g display-panes-active-colour default

# Clock mode
set -g clock-mode-colour colour4
set -g clock-mode-style 12

# Message
set -g message-style 'bg=colour3,fg=colour0'

# Command message
set -g message-command-style 'bg=colour3,fg=colour0'

# Mode (visual selection in copy mode)
set -g mode-style 'bg=colour3,fg=colour0'
