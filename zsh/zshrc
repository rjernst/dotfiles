  [kubectl]="pacman -S kubectl"
  [jq]="pacman -S jq"
  [vault]="pacman -S vault"
  [starship]="pacman -S starship"
)

# Helper used by role plugins to check for required commands at load time.
# Prints a warning listing any missing commands with install hints, returns 1
# if any are absent.
# Usage: _dotfiles_require_cmds "context" cmd1 cmd2 ... || return
_dotfiles_install_hint() {
  if [[ $OSTYPE == darwin* ]]; then
    echo "${_dotfiles_brew_pkg[$1]}"
  elif [[ $OSTYPE == linux* ]]; then
    echo "${_dotfiles_pacman_pkg[$1]}"
  fi
}
_dotfiles_require_cmds() {
  local context=$1; shift
  local missing=()
  for cmd in "$@"; do
    (( $+commands[$cmd] )) || missing+=($cmd)
  done
  (( ${#missing} )) || return 0

  if (( ${#missing} == 1 )); then
    local hint=$(_dotfiles_install_hint ${missing[1]})
    if [[ -n $hint ]]; then
      print -P "%F{yellow}[dotfiles]%f $context — missing: %F{red}${missing[1]}%f  →  %F{green}$hint%f"
    else
      print -P "%F{yellow}[dotfiles]%f $context — missing: %F{red}${missing[1]}%f"
    fi
  else
    print -P "%F{yellow}[dotfiles]%f $context — missing:"
    for cmd in $missing; do
      local hint=$(_dotfiles_install_hint $cmd)
      if [[ -n $hint ]]; then
        print -P "  %F{red}$cmd%f  →  %F{green}$hint%f"
      else
        print -P "  %F{red}$cmd%f"
      fi
    done
  fi
  return 1
}

