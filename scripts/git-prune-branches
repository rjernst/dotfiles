#!/usr/bin/env zsh
#
# git-prune-branches
#
# Cleans up local branches whose PRs have been merged.
# For each non-protected branch, checks the GitHub API for a closed PR
# and prompts for deletion. Also removes the branch from remotes if present.

username=$(git config --get github.user)
if [ -z "$username" ]; then
  echo "Error: github.user is not set in git config."
  echo "Run: git config --global github.user <your-github-username>"
  exit 1
fi
repo=$(git config --get remote.upstream.url | sed 's/git@github.com://' | sed 's/\.git//')

branches=$(git branch --no-color | grep -v -E "^\\W*main$|^\\W*\\d+\\.x$|^\\W*\\d+.\\d+$" | sed 's/\*/ /')
remotes="origin
upstream"

if [ ! -z "$branches" ] ; then
  all=n
  delete=n
  for branch in $branches; do
    isMerged=$(git api "/repos/$repo/pulls?state=closed&head=$username:$branch" | jq '. | length')
    if [ "$isMerged" = '1' ]; then
      if [ "$all" = 'n' ] ; then
        delete=n
        read -p "Delete $branch (y=yes, n=no, a=all)? " prompt
        if [ "$prompt" = 'a' ] ; then
          delete=y
          all=y
        elif [ "$prompt" = 'y' ]; then
          delete=y
        fi
      fi
      
      if [ "$delete" = 'y' ] ; then
        git branch -D "$branch"
        for remote in $remotes; do
          if [[ $(git ls-remote "$remote" "$branch") ]]; then
            git push -f "$remote" :"$branch"
          fi
        done
      fi
    fi
  done
fi
