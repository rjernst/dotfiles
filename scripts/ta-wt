#!/usr/bin/env python3
"""ta-wt — Worktree manager
Subcommands: list, create, remove, prune, status, merge
"""

import argparse
import json
import os
import subprocess
import sys
from dataclasses import dataclass
from typing import List, Tuple

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tools", "libs"))
from dotlib.git import Git


# ---------------------------------------------------------------------------
# Data model
# ---------------------------------------------------------------------------

@dataclass
class Worktree:
    path: str
    branch: str


# ---------------------------------------------------------------------------
# Core functions
# ---------------------------------------------------------------------------

def parse_worktrees(git: Git) -> List[Worktree]:
    """Parse `git worktree list --porcelain`. Skip bare worktrees.
    Handle detached HEAD as '(detached)'.
    """
    try:
        result = git.run("worktree", "list", "--porcelain")
    except subprocess.CalledProcessError:
        return []

    lines = result.stdout.splitlines()
    # Ensure trailing blank line to flush the last entry
    if lines and lines[-1] != "":
        lines.append("")

    worktrees = []
    wt_path = ""
    wt_branch = ""
    wt_bare = False
    wt_detached = False

    for line in lines:
        if line.startswith("worktree "):
            wt_path = line[len("worktree "):]
        elif line.startswith("branch "):
            ref = line[len("branch "):]
            if ref.startswith("refs/heads/"):
                wt_branch = ref[len("refs/heads/"):]
            else:
                wt_branch = ref
        elif line.startswith("HEAD "):
            pass  # skip HEAD hash
        elif line == "bare":
            wt_bare = True
        elif line == "detached":
            wt_detached = True
        elif line == "":
            if not wt_path:
                continue
            if wt_bare:
                wt_path = wt_branch = ""
                wt_bare = wt_detached = False
                continue
            if wt_detached:
                wt_branch = "(detached)"
            worktrees.append(Worktree(
                path=os.path.realpath(wt_path),
                branch=wt_branch,
            ))
            wt_path = wt_branch = ""
            wt_bare = wt_detached = False

    return worktrees


def dirty_status(git: Git, wt_dir: str) -> str:
    """Parse `git status --porcelain`. Return 'clean' or 'dirty(2S,1M,3U)'."""
    try:
        result = git.run("status", "--porcelain", cwd=wt_dir)
    except subprocess.CalledProcessError:
        return "clean"

    staged = modified = untracked = 0
    for line in result.stdout.splitlines():
        if not line:
            continue
        xy = line[:2] if len(line) >= 2 else "  "
        if xy[0] == "?":
            untracked += 1
        else:
            if xy[0] not in (" ", "?"):
                staged += 1
            if xy[1] not in (" ", "?"):
                modified += 1

    total = staged + modified + untracked
    if total == 0:
        return "clean"

    parts = []
    if staged > 0:
        parts.append(f"{staged}S")
    if modified > 0:
        parts.append(f"{modified}M")
    if untracked > 0:
        parts.append(f"{untracked}U")
    return "dirty(" + ",".join(parts) + ")"


def ahead_behind(git: Git, branch: str, base: str = "main") -> Tuple[int, int]:
    """Run `git rev-list --left-right --count`. Return (ahead, behind) as ints."""
    if branch == "(detached)":
        return (0, 0)
    try:
        result = git.run("rev-list", "--left-right", "--count", f"{branch}...{base}")
        parts = result.stdout.strip().split()
        if len(parts) == 2:
            return (int(parts[0]), int(parts[1]))
    except (subprocess.CalledProcessError, ValueError):
        pass
    return (0, 0)


def has_active_operation(git: Git, wt_dir: str) -> bool:
    """Check for active git operations (rebase, merge, cherry-pick)."""
    try:
        git_dir = git.output("rev-parse", "--git-dir", cwd=wt_dir)
    except subprocess.CalledProcessError:
        return False
    if not git_dir:
        return False
    if not os.path.isabs(git_dir):
        git_dir = os.path.join(wt_dir, git_dir)
    return (
        os.path.isdir(os.path.join(git_dir, "rebase-merge"))
        or os.path.isdir(os.path.join(git_dir, "rebase-apply"))
        or os.path.isfile(os.path.join(git_dir, "MERGE_HEAD"))
        or os.path.isfile(os.path.join(git_dir, "CHERRY_PICK_HEAD"))
    )


def default_wt_path(git: Git, branch: str) -> str:
    """Generate default worktree path: {parent}/{repo_name}-{sanitized_branch}."""
    repo_root = git.output("rev-parse", "--show-toplevel")
    repo_name = os.path.basename(repo_root)
    sanitized = branch.replace("/", "-")
    return os.path.join(os.path.dirname(repo_root), f"{repo_name}-{sanitized}")


def classify_status(git: Git, wt_dir: str, branch: str, current_wt: str,
                    base: str = "main") -> str:
    """Multi-stage classification. First match wins:
    current → merged → wip → conflict → almost → ready
    """
    import shutil

    # 1. Current worktree
    if wt_dir == current_wt:
        return "current"

    # 2. Merged (true merge)
    try:
        git.run("merge-base", "--is-ancestor", branch, base)
        return "merged"
    except subprocess.CalledProcessError:
        pass

    # 2b. Squash-merge detection via merge-tree --write-tree
    # Only meaningful if branch has actual file changes vs base
    try:
        branch_tree = git.output("rev-parse", f"{branch}^{{tree}}")
        base_tree = git.output("rev-parse", f"{base}^{{tree}}")
        if branch_tree and base_tree and branch_tree != base_tree:
            mt_result = git.run("merge-tree", "--write-tree", base, branch, check=False)
            if mt_result.returncode == 0:
                mt_first_line = mt_result.stdout.splitlines()[0] if mt_result.stdout else ""
                if mt_first_line and mt_first_line == base_tree:
                    return "merged"
    except Exception:
        pass

    # 2c. Squash-merge fallback via gh pr list
    if shutil.which("gh"):
        try:
            pr_result = subprocess.run(
                ["gh", "pr", "list", "--head", branch, "--state", "merged",
                 "--json", "number", "--limit", "1"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                check=False,
            )
            if pr_result.returncode == 0:
                pr_data = pr_result.stdout.strip()
                if pr_data and pr_data != "[]":
                    return "merged"
        except Exception:
            pass

    # 3. Dirty working tree → wip
    ds = dirty_status(git, wt_dir)
    if ds != "clean":
        return "wip"

    # 4. Conflict detection via git merge-tree (three-way)
    try:
        merge_base = git.output("merge-base", base, branch)
        if merge_base:
            merge_result = git.output("merge-tree", merge_base, base, branch)
            if "<<<" in merge_result or "changed in both" in merge_result:
                return "conflict"
    except Exception:
        pass

    # 5. Ahead check → almost or ready
    ahead_val, _ = ahead_behind(git, branch, base)
    if ahead_val > 0:
        try:
            upstream_count = git.output(
                "rev-list", "--count", f"{branch}@{{upstream}}..{branch}"
            )
            if not upstream_count or int(upstream_count) > 0:
                return "almost"
            return "ready"
        except (subprocess.CalledProcessError, ValueError):
            return "almost"

    return "ready"


# ---------------------------------------------------------------------------
# Subcommand: list
# ---------------------------------------------------------------------------

def cmd_list(git: Git, as_json: bool = False, full: bool = False):
    """List worktrees with status."""
    current_wt = os.path.realpath(os.getcwd())
    worktrees = parse_worktrees(git)

    if as_json:
        items = []
        for wt in worktrees:
            status = "current" if wt.path == current_wt else dirty_status(git, wt.path)
            ahead_val, behind_val = ahead_behind(git, wt.branch)
            item = {
                "branch": wt.branch,
                "status": status,
                "ahead": ahead_val,
                "behind": behind_val,
                "path": wt.path,
            }
            if full:
                item["commit_message"] = git.output("log", "-1", "--format=%s", cwd=wt.path)
                item["commit_date"] = git.output("log", "-1", "--format=%aI", cwd=wt.path)
            items.append(item)
        print(json.dumps(items))
        return

    # Text output
    if full:
        print(f"{'BRANCH':<24} {'STATUS':<14} {'AHEAD':<6} {'BEHIND':<7} {'LAST COMMIT':<30} PATH")
    else:
        print(f"{'BRANCH':<24} {'STATUS':<14} {'AHEAD':<6} {'BEHIND':<7} PATH")

    for wt in worktrees:
        status = "current" if wt.path == current_wt else dirty_status(git, wt.path)
        ahead_val, behind_val = ahead_behind(git, wt.branch)
        if full:
            commit_msg = git.output("log", "-1", "--format=%s (%cr)", cwd=wt.path) or "\u2014"
            if len(commit_msg) > 28:
                commit_msg = commit_msg[:25] + "..."
            print(f"{wt.branch:<24} {status:<14} {ahead_val:<6} {behind_val:<7} {commit_msg:<30} {wt.path}")
        else:
            print(f"{wt.branch:<24} {status:<14} {ahead_val:<6} {behind_val:<7} {wt.path}")


# ---------------------------------------------------------------------------
# Subcommand: create
# ---------------------------------------------------------------------------

def cmd_create(git: Git, branch: str, path: str = "", remote: str = "",
               from_base: str = ""):
    """Create a worktree tracking a remote branch or from a base branch."""
    if from_base:
        _create_from(git, branch, path, from_base)
    else:
        # Determine remote: explicit > upstream > origin
        if not remote:
            remotes_raw = git.output("remote")
            remotes = remotes_raw.splitlines() if remotes_raw else []
            if "upstream" in remotes:
                remote = "upstream"
            elif "origin" in remotes:
                remote = "origin"
            else:
                print("ta: no remote found (tried upstream, origin)", file=sys.stderr)
                sys.exit(1)
        _create_tracking(git, branch, path, remote)


def _create_tracking(git: Git, branch: str, wt_path: str, remote: str):
    """Track an existing remote branch."""
    result = git.run(
        "ls-remote", "--exit-code", "--heads", remote, f"refs/heads/{branch}",
        check=False,
    )
    if result.returncode != 0:
        print(f"ta: branch '{branch}' not found on remote '{remote}'", file=sys.stderr)
        sys.exit(1)

    if not wt_path:
        wt_path = default_wt_path(git, branch)

    if os.path.exists(wt_path):
        print(f"ta: path already exists: {wt_path}", file=sys.stderr)
        sys.exit(1)

    git.run("worktree", "add", "--track", "-b", branch, wt_path, f"{remote}/{branch}")
    print(wt_path)


def _create_from(git: Git, branch: str, wt_path: str, base: str):
    """Create a new branch from base, or checkout existing branch."""
    if not wt_path:
        wt_path = default_wt_path(git, branch)

    if os.path.exists(wt_path):
        print(f"ta: path already exists: {wt_path}", file=sys.stderr)
        sys.exit(1)

    # Check if branch already exists locally
    result = git.run(
        "show-ref", "--verify", "--quiet", f"refs/heads/{branch}", check=False
    )
    if result.returncode == 0:
        # Branch exists — verify it's a descendant of base
        try:
            git.run("merge-base", "--is-ancestor", base, branch)
        except subprocess.CalledProcessError:
            print(f"ta: branch '{branch}' is not based on '{base}'", file=sys.stderr)
            sys.exit(1)
        git.run("worktree", "add", wt_path, branch)
    else:
        git.run("worktree", "add", "-b", branch, wt_path, base)

    print(wt_path)


# ---------------------------------------------------------------------------
# Subcommand: remove
# ---------------------------------------------------------------------------

def _find_wt_by_branch(git: Git, branch: str):
    """Return the worktree path for the given branch, or None."""
    for wt in parse_worktrees(git):
        if wt.branch == branch:
            return wt.path
    return None


def cmd_remove(branch: str, git: Git, force: bool = False):
    """Remove a worktree by branch name.

    Refuses to run if the current process is inside the worktree being
    removed — that would leave the shell with a dangling cwd and cause
    subsequent git commands (including the internal `git branch -D`) to
    fail silently, producing zombie branches. Callers that legitimately
    need to tear down the "current" worktree — notably cmd_merge — are
    expected to os.chdir() to a stable location first.
    """
    wt_dir = _find_wt_by_branch(git, branch)
    if wt_dir is None:
        print(f"ta: no worktree found for branch '{branch}'", file=sys.stderr)
        sys.exit(1)

    try:
        cwd_real = os.path.realpath(os.getcwd())
    except FileNotFoundError:
        cwd_real = ""
    wt_real = os.path.realpath(wt_dir)
    if cwd_real and (cwd_real == wt_real or cwd_real.startswith(wt_real + os.sep)):
        print(f"ta: cannot remove worktree '{branch}' while inside it "
              f"(current directory: {cwd_real})", file=sys.stderr)
        print("ta: cd outside the worktree first, then retry", file=sys.stderr)
        sys.exit(1)

    if not force:
        ds = dirty_status(git, wt_dir)
        if ds != "clean":
            print(f"ta: worktree '{branch}' has uncommitted changes ({ds})", file=sys.stderr)
            print("ta: use --force to remove anyway", file=sys.stderr)
            sys.exit(1)

    if force:
        git.run("worktree", "remove", "--force", wt_dir)
    else:
        git.run("worktree", "remove", wt_dir)

    print(f"ta: removed worktree '{branch}' ({wt_dir})")

    # Delete the branch ref. Failures here are the exact zombie-branch
    # condition this module is built to prevent, so they must be visible —
    # report the error and exit non-zero even though the worktree itself is
    # already gone. Caller (cmd_merge) catches SystemExit and treats it as
    # "cleanup incomplete".
    del_result = git.run("branch", "-D", branch, check=False)

    # Cleanup: kill workspace session (suppress errors). Run this before
    # the branch-delete failure check so the tmux session gets torn down
    # even in the partial-failure path — the session is tied to the
    # worktree, which is already gone regardless of branch-delete status.
    script_dir = os.path.dirname(os.path.realpath(__file__))
    workspace_script = os.path.join(script_dir, "ta-workspace")
    try:
        subprocess.run(
            [workspace_script, "kill", branch],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except Exception:
        pass

    if del_result.returncode != 0:
        err = (del_result.stderr or "").strip() or "unknown error"
        print(f"ta: warning: failed to delete branch '{branch}': {err}",
              file=sys.stderr)
        print(f"ta: branch '{branch}' still exists; delete manually with "
              f"'git branch -D {branch}'", file=sys.stderr)
        sys.exit(1)


# ---------------------------------------------------------------------------
# Spec issue helpers
# ---------------------------------------------------------------------------
#
# Ralph writes `branch.<branch>.issue` in git config when it starts work on a
# spec (see tools/ralph/src/ralph/loop.py). These helpers read that config,
# verify the associated GitHub issue is in a state consistent with merging,
# and close it. Both cmd_merge and cmd_prune use them, so the spec-close
# behavior is uniform across the "merge now" and "recover via /tidy" paths.


class SpecIssueError(Exception):
    """Raised when spec issue verification or close operations fail."""
    pass


def _read_spec_issue_number(git: Git, branch: str, cwd: str):
    """Read branch.<branch>.issue git config. Return the issue number as a
    string, or None if no config entry exists."""
    result = git.run("config", f"branch.{branch}.issue", cwd=cwd, check=False)
    if result.returncode != 0:
        return None
    value = result.stdout.strip()
    return value if value else None


def _verify_spec_issue_ready(issue_number: str, cwd: str):
    """Verify that a spec issue is ready to merge: requires both 'spec' and
    'status:done' labels. Raises SpecIssueError on any problem (gh missing,
    gh error, wrong labels)."""
    import shutil
    if not shutil.which("gh"):
        raise SpecIssueError(
            f"gh not found; cannot verify spec issue #{issue_number}"
        )

    try:
        result = subprocess.run(
            ["gh", "issue", "view", issue_number,
             "--json", "labels",
             "--jq", "[.labels[].name] | join(\",\")"],
            cwd=cwd,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
        )
    except FileNotFoundError:
        raise SpecIssueError(
            f"gh not found; cannot verify spec issue #{issue_number}"
        )

    if result.returncode != 0:
        err = (result.stderr or result.stdout).strip() or "unknown error"
        raise SpecIssueError(
            f"failed to fetch spec issue #{issue_number}: {err}"
        )

    labels_str = result.stdout.strip()
    labels = [lbl for lbl in labels_str.split(",") if lbl] if labels_str else []

    if "spec" not in labels:
        raise SpecIssueError(
            f"spec issue #{issue_number} is missing 'spec' label "
            f"(got: {','.join(labels) or 'none'})"
        )
    if "status:done" not in labels:
        raise SpecIssueError(
            f"spec issue #{issue_number} is not marked status:done "
            f"(got: {','.join(labels) or 'none'})"
        )


def _close_spec_issue(git: Git, branch: str, issue_number: str, cwd: str):
    """Close the spec issue on GitHub and unset branch.<branch>.issue.
    Raises SpecIssueError on failure to close; config is only unset on
    successful close."""
    import shutil
    if not shutil.which("gh"):
        raise SpecIssueError(
            f"gh not found; cannot close spec issue #{issue_number}"
        )

    try:
        result = subprocess.run(
            ["gh", "issue", "close", issue_number],
            cwd=cwd,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
        )
    except FileNotFoundError:
        raise SpecIssueError(
            f"gh not found; cannot close spec issue #{issue_number}"
        )

    if result.returncode != 0:
        err = (result.stderr or result.stdout).strip() or "unknown error"
        raise SpecIssueError(
            f"failed to close spec issue #{issue_number}: {err}"
        )

    git.run("config", "--unset", f"branch.{branch}.issue",
            cwd=cwd, check=False)


def _find_orphaned_spec_issue_configs(git: Git, cwd: str):
    """Scan git config for branch.<>.issue entries whose branches no longer
    exist locally. Returns a list of (branch_name, issue_number) tuples,
    sorted for deterministic output."""
    result = git.run("config", "--get-regexp", r"^branch\..*\.issue$",
                     cwd=cwd, check=False)
    # git config --get-regexp exits 1 when there are no matches (the common
    # case when no ralph work has ever been tracked). Any other non-zero
    # exit means the config read itself failed and we don't want to silently
    # hide that — report it and return empty so prune can still finish its
    # worktree work.
    if result.returncode == 1:
        return []
    if result.returncode != 0:
        err = (result.stderr or "").strip() or "unknown error"
        print(f"ta: warning: failed to scan for orphaned spec issues: {err}",
              file=sys.stderr)
        return []

    orphaned = []
    for line in result.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        key, issue_number = parts
        if not (key.startswith("branch.") and key.endswith(".issue")):
            continue
        branch_name = key[len("branch."):-len(".issue")]
        if not branch_name:
            continue

        ref_check = git.run("rev-parse", "--verify", "--quiet",
                            f"refs/heads/{branch_name}",
                            cwd=cwd, check=False)
        if ref_check.returncode == 0:
            continue  # branch still exists; not orphaned

        orphaned.append((branch_name, issue_number))

    orphaned.sort()
    return orphaned


# ---------------------------------------------------------------------------
# Subcommand: prune
# ---------------------------------------------------------------------------

def _is_merged(git: Git, branch: str, base: str = "main") -> bool:
    """Return True if branch is merged into base (true merge, squash, or merged PR)."""
    import shutil

    # True merge
    try:
        git.run("merge-base", "--is-ancestor", branch, base)
        return True
    except subprocess.CalledProcessError:
        pass

    # Squash-merge via merge-tree --write-tree
    # Only meaningful if branch has actual file changes vs base
    try:
        branch_tree = git.output("rev-parse", f"{branch}^{{tree}}")
        base_tree = git.output("rev-parse", f"{base}^{{tree}}")
        if branch_tree and base_tree and branch_tree != base_tree:
            mt_result = git.run("merge-tree", "--write-tree", base, branch, check=False)
            if mt_result.returncode == 0:
                mt_first_line = mt_result.stdout.splitlines()[0] if mt_result.stdout else ""
                if mt_first_line and mt_first_line == base_tree:
                    return True
    except Exception:
        pass

    # gh pr fallback
    if shutil.which("gh"):
        try:
            pr_result = subprocess.run(
                ["gh", "pr", "list", "--head", branch, "--state", "merged",
                 "--json", "number", "--limit", "1"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
            )
            if pr_result.returncode == 0:
                pr_data = pr_result.stdout.strip()
                if pr_data and pr_data != "[]":
                    return True
        except Exception:
            pass

    return False


def cmd_prune(git: Git, apply: bool = False):
    """Prune merged worktrees. Dry-run by default; --apply to execute.

    For each merged worktree with an associated spec issue, the issue is
    verified and closed before the worktree is removed. A spec issue that
    cannot be verified or closed causes the worktree to be skipped (not
    removed), so the user can fix the spec state and re-run prune.

    Also scans for orphaned branch.<>.issue configs whose branches no longer
    exist, closing any associated spec issues and cleaning up the stale
    config entries.
    """
    current_wt = os.path.realpath(os.getcwd())
    worktrees = parse_worktrees(git)

    found = False
    for wt in worktrees:
        if wt.branch == "main":
            continue
        if wt.branch == "(detached)":
            continue
        if wt.path == current_wt:
            continue

        if not _is_merged(git, wt.branch):
            continue

        found = True

        ds = dirty_status(git, wt.path)
        if ds != "clean":
            print(f"ta: skipping '{wt.branch}' (uncommitted changes: {ds})")
            continue

        if has_active_operation(git, wt.path):
            print(f"ta: skipping '{wt.branch}' (active git operation in progress)")
            continue

        # If this branch has an associated spec issue, verify it is closeable
        # before touching the worktree. A verification failure means we skip
        # this entry entirely so the user can fix the spec state and retry.
        issue_number = _read_spec_issue_number(git, wt.branch, cwd=current_wt)
        if issue_number is not None:
            try:
                _verify_spec_issue_ready(issue_number, cwd=current_wt)
            except SpecIssueError as e:
                print(f"ta: skipping '{wt.branch}': {e}")
                continue

        if apply:
            if issue_number is not None:
                try:
                    _close_spec_issue(git, wt.branch, issue_number,
                                      cwd=current_wt)
                    print(f"ta: closed spec issue #{issue_number} for '{wt.branch}'")
                except SpecIssueError as e:
                    print(f"ta: skipping '{wt.branch}': {e}")
                    continue
            cmd_remove(wt.branch, git, force=True)
        else:
            suffix = ""
            if issue_number is not None:
                suffix = f" [will close spec issue #{issue_number}]"
            print(f"ta: would remove '{wt.branch}' ({wt.path}) [merged]{suffix}")

    # Scan for orphaned spec issue configs: branch.<>.issue entries whose
    # branches no longer exist. Catches historical zombies and any state
    # where a branch was deleted outside of the normal merge flow.
    orphaned = _find_orphaned_spec_issue_configs(git, cwd=current_wt)
    for orphan_branch, orphan_issue in orphaned:
        found = True
        try:
            _verify_spec_issue_ready(orphan_issue, cwd=current_wt)
        except SpecIssueError as e:
            print(f"ta: skipping orphaned spec issue #{orphan_issue} "
                  f"for '{orphan_branch}': {e}")
            continue

        if apply:
            try:
                _close_spec_issue(git, orphan_branch, orphan_issue,
                                  cwd=current_wt)
                print(f"ta: closed orphaned spec issue #{orphan_issue} "
                      f"(branch '{orphan_branch}' no longer exists)")
            except SpecIssueError as e:
                print(f"ta: skipping orphaned spec issue #{orphan_issue} "
                      f"for '{orphan_branch}': {e}")
        else:
            print(f"ta: would close orphaned spec issue #{orphan_issue} "
                  f"for deleted branch '{orphan_branch}'")

    if not found:
        print("ta: no worktrees to prune")


# ---------------------------------------------------------------------------
# Subcommand: status
# ---------------------------------------------------------------------------

def cmd_status(git: Git, as_json: bool = False):
    """Quick one-line status of each non-main worktree."""
    current_wt = os.path.realpath(os.getcwd())
    worktrees = parse_worktrees(git)

    if as_json:
        items = []
        for wt in worktrees:
            if wt.branch == "main":
                continue
            classification = classify_status(git, wt.path, wt.branch, current_wt)
            ahead_val, behind_val = ahead_behind(git, wt.branch)
            ds = dirty_status(git, wt.path)
            items.append({
                "branch": wt.branch,
                "status": classification,
                "ahead": ahead_val,
                "behind": behind_val,
                "dirty": ds,
                "path": wt.path,
            })
        print(json.dumps(items))
        return

    for wt in worktrees:
        if wt.branch == "main":
            continue
        classification = classify_status(git, wt.path, wt.branch, current_wt)
        ahead_val, _ = ahead_behind(git, wt.branch)
        ds = dirty_status(git, wt.path)
        print(f"{wt.branch:<24} {classification:<10} {ahead_val} ahead, {ds}")


# ---------------------------------------------------------------------------
# Subcommand: merge
# ---------------------------------------------------------------------------

def cmd_merge(git: Git, branch: str, target: str = "main", message: str = "",
              message_file: str = ""):
    """Squash-rebase branch and fast-forward merge into target with cleanup."""
    msg = message
    msg_file = message_file

    if msg and msg_file:
        print("ta: cannot use both --message and --message-file", file=sys.stderr)
        sys.exit(2)

    if msg_file and not os.path.isfile(msg_file):
        print(f"ta: message file not found: {msg_file}", file=sys.stderr)
        sys.exit(2)

    # Find target worktree
    main_wt = _find_wt_by_branch(git, target)
    if main_wt is None:
        print(f"ta: cannot find worktree for target branch '{target}'", file=sys.stderr)
        sys.exit(1)

    # Find branch worktree
    branch_wt = _find_wt_by_branch(git, branch)
    if branch_wt is None:
        print(f"ta: no worktree found for branch '{branch}'", file=sys.stderr)
        sys.exit(2)

    # Validate both worktrees are clean
    ds = dirty_status(git, branch_wt)
    if ds != "clean":
        print(f"ta: branch '{branch}' has uncommitted changes ({ds})", file=sys.stderr)
        sys.exit(1)

    ds = dirty_status(git, main_wt)
    if ds != "clean":
        print(f"ta: target worktree '{target}' has uncommitted changes ({ds})", file=sys.stderr)
        sys.exit(1)

    # Anchor Python's cwd to the target worktree. branch_wt is about to be
    # removed (cmd_remove --force works even if we are inside it), and if
    # Python's cwd is dangling, every subsequent subprocess call that does
    # not pass cwd= explicitly fails with "Unable to read current working
    # directory". That is how zombie branches and unclosed spec issues were
    # accumulating before this fix.
    os.chdir(main_wt)

    # Pre-flight: if this branch has an associated spec issue, verify it is
    # ready to merge (must have 'spec' and 'status:done' labels). A mismatch
    # aborts before any merge state is touched — the spec label is the
    # ground truth for "work is done", so a label mismatch signals that
    # something is misaligned and the user should investigate.
    issue_number = _read_spec_issue_number(git, branch, cwd=main_wt)
    if issue_number is not None:
        try:
            _verify_spec_issue_ready(issue_number, cwd=main_wt)
        except SpecIssueError as e:
            print(f"ta: {e}", file=sys.stderr)
            sys.exit(1)

    # Squash-rebase: collapse the branch into a single commit, then
    # fast-forward merge into the target. This ensures the squashed commit
    # is literally in the target's history, so merge-base --is-ancestor
    # can detect it — unlike git merge --squash which creates a new commit
    # that shares no ancestry with the branch.

    # Save the original branch tip so we can restore on failure
    orig_branch_head = git.output("rev-parse", "HEAD", cwd=branch_wt)

    # Find the merge base between target and branch
    merge_base = git.output("merge-base", target, branch, cwd=branch_wt)
    if not merge_base:
        print(f"ta: cannot find merge base between '{target}' and '{branch}'",
              file=sys.stderr)
        sys.exit(1)

    # Squash all branch commits into one: soft-reset to the merge base
    # (stages all changes), then commit with the provided message.
    git.run("reset", "--soft", merge_base, cwd=branch_wt)

    commit_cmd = ["git", "commit"]
    if msg_file:
        commit_cmd += ["--file", msg_file]
    elif msg:
        commit_cmd += ["-m", msg]
    else:
        commit_cmd += ["-m", f"Squashed '{branch}' into {target}"]

    commit_result = subprocess.run(
        commit_cmd, cwd=branch_wt,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if commit_result.returncode != 0:
        print("ta: squash commit failed", file=sys.stderr)
        git.run("reset", "--hard", orig_branch_head, cwd=branch_wt, check=False)
        sys.exit(1)

    # Rebase the single squashed commit onto the target so it fast-forwards
    result = git.run("rebase", target, cwd=branch_wt, check=False)
    if result.returncode != 0:
        print("ta: rebase conflicts detected, aborting", file=sys.stderr)
        git.run("rebase", "--abort", cwd=branch_wt, check=False)
        git.run("reset", "--hard", orig_branch_head, cwd=branch_wt, check=False)
        sys.exit(1)

    # Fast-forward merge into target
    result = git.run("merge", "--ff-only", branch, cwd=main_wt, check=False)
    if result.returncode != 0:
        print("ta: fast-forward merge failed", file=sys.stderr)
        git.run("reset", "--hard", orig_branch_head, cwd=branch_wt, check=False)
        sys.exit(1)

    commit_hash = git.output("rev-parse", "--short", "HEAD", cwd=main_wt)

    # Close the spec issue BEFORE cmd_remove. cmd_remove kills the tmux
    # session (via ta-workspace kill) as its final step, which will tear
    # down this very process — so any step that must be observable has to
    # finish before cmd_remove runs. On failure, exit non-zero: the merge
    # has already landed on target, but the session stays alive, the error
    # is visible, and the user can recover via /tidy (ta wt prune --apply),
    # which will retry the close and finish the cleanup.
    if issue_number is not None:
        try:
            _close_spec_issue(git, branch, issue_number, cwd=main_wt)
            print(f"ta: closed spec issue #{issue_number}")
        except SpecIssueError as e:
            print(f"ta: {e}", file=sys.stderr)
            print(f"ta: merge landed as {commit_hash} but cleanup incomplete; "
                  f"run 'ta wt prune --apply' (or /tidy) after fixing the issue",
                  file=sys.stderr)
            sys.exit(1)

    # Cleanup: remove worktree (force). This also kills the workspace tmux
    # session as its final step, so anything printed after this point may
    # not be observed.
    cleanup_ok = True
    try:
        cmd_remove(branch, git, force=True)
    except SystemExit:
        # cmd_remove already printed a specific warning explaining which
        # step failed (worktree remove vs branch delete). Our job here is
        # to note that the merge landed but cleanup was partial.
        print("ta: warning: worktree cleanup incomplete (see above)",
              file=sys.stderr)
        cleanup_ok = False

    print(f"ta: merged '{branch}' into {target} ({commit_hash})")
    if cleanup_ok:
        print("ta: worktree and branch removed")


# ---------------------------------------------------------------------------
# Argument parser
# ---------------------------------------------------------------------------

USAGE = """\
usage: ta wt <command> [args...]

Commands:
  list      List all worktrees with enriched status
  create    Create a worktree tracking a remote branch
  remove    Remove a worktree by branch name
  prune     Remove worktrees merged into main
  merge     Squash-rebase and fast-forward merge a branch into main
  status    Quick one-line status of each worktree
"""

KNOWN_SUBCOMMANDS = {"list", "create", "remove", "prune", "status", "merge"}


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ta wt",
        description="Worktree manager",
        add_help=True,
    )
    subparsers = parser.add_subparsers(dest="subcommand")

    # list
    lp = subparsers.add_parser("list", help="List all worktrees with enriched status")
    lp.add_argument("--json", action="store_true", help="Output as JSON")
    lp.add_argument("--full", action="store_true", help="Include last commit info")

    # create
    cp = subparsers.add_parser("create", help="Create a worktree")
    cp.add_argument("branch", help="Branch name")
    cp.add_argument("path", nargs="?", default="", help="Worktree path (optional)")
    cp.add_argument("--remote", default="", help="Remote name")
    cp.add_argument("--from", dest="from_base", default="", metavar="BASE",
                    help="Create new branch from base")

    # remove
    rp = subparsers.add_parser("remove", help="Remove a worktree by branch name")
    rp.add_argument("branch", help="Branch name")
    rp.add_argument("--force", action="store_true", help="Remove even if dirty")

    # prune
    pp = subparsers.add_parser("prune", help="Remove worktrees merged into main")
    pp.add_argument("--apply", action="store_true", help="Actually remove (default: dry-run)")

    # status
    sp = subparsers.add_parser("status", help="Quick one-line status of each worktree")
    sp.add_argument("--json", action="store_true", help="Output as JSON")

    # merge
    mp = subparsers.add_parser("merge", help="Squash-rebase and fast-forward merge a branch into main")
    mp.add_argument("branch", help="Branch to merge")
    mp.add_argument("--target", default="main", help="Target branch (default: main)")
    mp.add_argument("--message", default="", help="Commit message")
    mp.add_argument("--message-file", dest="message_file", default="",
                    help="Read commit message from file")

    return parser


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    if len(sys.argv) < 2:
        sys.stderr.write(USAGE)
        sys.exit(2)

    subcommand = sys.argv[1]
    if not subcommand.startswith("-") and subcommand not in KNOWN_SUBCOMMANDS:
        print(f"ta: unknown wt command '{subcommand}'", file=sys.stderr)
        sys.exit(2)

    parser = build_parser()
    args, remaining = parser.parse_known_args()

    if remaining:
        print(f"ta: unknown option '{remaining[0]}'", file=sys.stderr)
        sys.exit(2)

    git = Git()

    if args.subcommand == "list":
        cmd_list(git, as_json=args.json, full=args.full)
    elif args.subcommand == "create":
        cmd_create(git, args.branch, path=args.path, remote=args.remote,
                   from_base=args.from_base)
    elif args.subcommand == "remove":
        cmd_remove(args.branch, git, force=args.force)
    elif args.subcommand == "prune":
        cmd_prune(git, apply=args.apply)
    elif args.subcommand == "status":
        cmd_status(git, as_json=args.json)
    elif args.subcommand == "merge":
        cmd_merge(git, args.branch, target=args.target, message=args.message,
                  message_file=args.message_file)
    else:
        sys.stderr.write(USAGE)
        sys.exit(2)


if __name__ == "__main__":
    main()
