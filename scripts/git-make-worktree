#!/usr/bin/env zsh

# Deprecated: use `ta wt create` instead.
echo "git make-worktree is deprecated, use 'ta wt create <branch> [path]' instead" >&2

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: git make-worktree BRANCH [PATH]" >&2
  exit 1
fi

script_dir="${0:A:h}"
exec "$script_dir/ta-wt" create "$@"
