#!/bin/bash
# tmux-agent-snapshot — capture running Claude Code sessions across all tmux
# windows and emit a restore script that recreates the layout and resumes each
# conversation.
#
# Claude Code records a live pid -> sessionId mapping in ~/.claude/sessions/<pid>.json,
# which is what makes the pane-to-conversation mapping exact rather than inferred
# from transcript mtimes. The claude process is a child of the pane's shell, so
# each pane pid is walked one level down to find it.
#
# Panes running something other than Claude Code are emitted as commented-out
# lines in the restore script: visible for reference, inert on restore.
#
# Usage: tmux-agent-snapshot [output-dir]

set -euo pipefail

tmux info >/dev/null 2>&1 || { echo "tmux not running, skipping snapshot"; exit 0; }

base=${1:-$HOME/.tmux-snapshot}
out="$base/current"
tmpout="$base/current.$$.tmp"
mkdir -p "$tmpout"

manifest="$tmpout/manifest.tsv"
restore="$tmpout/restore.sh"

base_index=$(tmux show-options -gv base-index 2>/dev/null || echo 0)

# Tab is an IFS whitespace character, so `read` collapses runs of tabs and an
# empty field would silently shift every later field left. Empty values are
# written as NONE and interpreted on the way back out.
readonly EMPTY=NONE

session_id_for_pane() {
    local pane_pid=$1 child f sid
    for child in $(pgrep -P "$pane_pid" 2>/dev/null); do
        f="$HOME/.claude/sessions/$child.json"
        if [ -f "$f" ]; then
            sid=$(python3 -c "import json;print(json.load(open('$f')).get('sessionId',''))" 2>/dev/null || true)
            if [ -n "$sid" ]; then
                printf '%s' "$sid"
                return 0
            fi
        fi
    done
    printf '%s' "$EMPTY"
}

printf 'session\twindow\tname\tauto_rename\tcommand\tsession_id\tcwd\n' > "$manifest"

while IFS=$'\t' read -r sess idx name auto cmd pane_pid cwd; do
    sid=$(session_id_for_pane "$pane_pid")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$sess" "$idx" "${name:-$EMPTY}" "$auto" "$cmd" "$sid" "${cwd:-$EMPTY}" >> "$manifest"
done < <(tmux list-panes -a -F \
    '#{session_name}	#{window_index}	#{window_name}	#{automatic-rename}	#{pane_current_command}	#{pane_pid}	#{pane_current_path}')

claude_count=$(awk -F'\t' -v e="$EMPTY" 'NR>1 && $6!=e' "$manifest" | wc -l | tr -d ' ')
other_count=$(awk -F'\t' -v e="$EMPTY" 'NR>1 && $6==e' "$manifest" | wc -l | tr -d ' ')

{
    echo '#!/bin/bash'
    echo "# Generated by tmux-agent-snapshot on $(date)"
    echo "# Recreates $claude_count Claude Code session(s). $other_count non-Claude pane(s) listed as comments."
    echo '#'
    echo '# Existing tmux sessions are left untouched, so this is safe to re-run.'
    echo '# Pass --no-enter to stage the resume commands without executing them.'
    echo
    echo 'set -uo pipefail'
    echo
    echo 'send_enter=Enter'
    echo '[ "${1:-}" = "--no-enter" ] && send_enter='
    echo
} > "$restore"

# Emit one block per tmux session, in the order sessions appear in the manifest.
awk -F'\t' -v e="$EMPTY" 'NR>1 && $6!=e {print $1}' "$manifest" | awk '!seen[$0]++' | while read -r sess; do
    {
        echo "# ---------- session: $sess ----------"
        echo "if tmux has-session -t $(printf '%q' "$sess") 2>/dev/null; then"
        echo "    echo 'skip: session $sess already exists'"
        echo "else"
    } >> "$restore"

    first=1
    while IFS=$'\t' read -r s idx name auto cmd sid cwd; do
        [ "$s" = "$sess" ] || continue
        [ "$sid" != "$EMPTY" ] || continue

        qsess=$(printf '%q' "$sess")
        qcwd=$(printf '%q' "$cwd")
        # An unnamed window is by definition auto-renamed, so let tmux name it.
        nameopt=""
        [ "$name" != "$EMPTY" ] && nameopt=" -n $(printf '%q' "$name")"

        if [ "$first" = 1 ]; then
            echo "    tmux new-session -d -s $qsess -c $qcwd$nameopt" >> "$restore"
            # new-session lands the window at base-index; shift it if the
            # original index differed.
            if [ "$idx" != "$base_index" ]; then
                echo "    tmux move-window -s $qsess:$base_index -t $qsess:$idx" >> "$restore"
            fi
            first=0
        else
            echo "    tmux new-window -d -t $qsess:$idx -c $qcwd$nameopt" >> "$restore"
        fi

        # Passing -n implicitly turns automatic-rename off, so restore the
        # original setting explicitly. Windows that had it on keep the captured
        # name only until tmux regenerates one, which is the desired behaviour.
        if [ "$auto" = "0" ]; then
            echo "    tmux set-window-option -t $qsess:$idx automatic-rename off" >> "$restore"
        else
            echo "    tmux set-window-option -t $qsess:$idx automatic-rename on" >> "$restore"
        fi
    done < "$manifest"

    # Shells need a moment to reach a prompt before they will accept input.
    echo "    sleep 2" >> "$restore"

    while IFS=$'\t' read -r s idx name auto cmd sid cwd; do
        [ "$s" = "$sess" ] || continue
        [ "$sid" != "$EMPTY" ] || continue
        echo "    tmux send-keys -t $(printf '%q' "$sess"):$idx 'claude --resume $sid' \$send_enter" >> "$restore"
    done < "$manifest"

    {
        echo "    echo 'restored: $sess'"
        echo "fi"
        echo
    } >> "$restore"
done

# Record skipped panes so nothing silently disappears from the inventory.
if [ "$other_count" -gt 0 ]; then
    {
        echo '# ---------- not restored (non-Claude panes) ----------'
        while IFS=$'\t' read -r sess idx name auto cmd sid cwd; do
            [ "$sid" = "$EMPTY" ] || continue
            echo "#   $sess:$idx [$cmd] $cwd"
        done < <(tail -n +2 "$manifest")
        echo
    } >> "$restore"
fi

echo 'echo "Done. Attach with: tmux attach -t main"' >> "$restore"

chmod +x "$restore"

# Atomic rotation: bak <- current, current <- new
[ -d "$base/current.bak" ] && rm -rf "$base/current.bak"
[ -d "$out" ] && mv "$out" "$base/current.bak"
mv "$tmpout" "$out"

echo "Snapshot written to $out ($claude_count Claude session(s), $other_count other pane(s))"
