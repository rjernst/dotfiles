#!/usr/bin/env zsh
# ralph — GitHub Issues-driven AI coding loop
#
# Fetches specs from GitHub Issues (labeled spec + status:ready), runs
# Claude Code in Docker to implement one task per iteration, updates
# issue checkboxes, and labels issues done when complete.
#
# Usage: ralph [options]
#
# Options:
#   --issue <number>      Execute a single GitHub Issue spec
#   --poll                Poll for status:ready issues and process them
#   --interval <duration> Poll interval (default: 30s, requires --poll)
#   --timeout <duration>  Limit poll duration (e.g. 30m, 4h, 1d; requires --poll)
#   --packages "pkg ..."  Extra apt packages baked into image
#   --push                Git push after each iteration
#   --model <model>       Claude model (default: sonnet)
#   -h, --help            Show usage
set -e
zmodload zsh/datetime

SELF=${0:A}

usage() {
  sed -n '/^# Usage:/,/^[^#]/p' "$SELF" | sed -n 's/^# \{0,1\}//p'
  exit "${1:-0}"
}

parse_duration() {
  local input=$1
  if [[ -z $input ]]; then
    echo "ralph: invalid duration: empty string" >&2
    exit 2
  fi
  local num suffix
  if [[ $input =~ '^([0-9]+)([smhd]?)$' ]]; then
    num=$match[1]
    suffix=$match[2]
  else
    echo "ralph: invalid duration: $input" >&2
    exit 2
  fi
  case $suffix in
    s|'') echo $(( num )) ;;
    m)    echo $(( num * 60 )) ;;
    h)    echo $(( num * 3600 )) ;;
    d)    echo $(( num * 86400 )) ;;
  esac
}

# --- defaults ---
PACKAGES=""
PUSH=0
TIMEOUT=0
MODEL=sonnet
ISSUE_NUMBER=""
POLL=0
INTERVAL=30

# --- parse args ---
while [[ $# -gt 0 ]]; do
  case $1 in
    --packages)
      PACKAGES=$2; shift 2 ;;
    --push)
      PUSH=1; shift ;;
    --issue)
      ISSUE_NUMBER=$2; shift 2 ;;
    --poll)
      POLL=1; shift ;;
    --interval)
      INTERVAL=$(parse_duration "$2"); shift 2 ;;
    --model)
      MODEL=$2; shift 2 ;;
    --timeout)
      TIMEOUT=$(parse_duration "$2"); shift 2 ;;
    -h|--help)
      usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2; usage 1 ;;
  esac
done

if (( POLL )) && [[ -n $ISSUE_NUMBER ]]; then
  echo "ralph: --poll and --issue cannot be used together" >&2
  exit 2
fi

if (( ! POLL )) && (( INTERVAL != 30 )); then
  echo "ralph: --interval requires --poll" >&2
  exit 2
fi

if (( TIMEOUT > 0 )) && (( ! POLL )); then
  echo "ralph: --timeout requires --poll" >&2
  exit 2
fi

if ! command -v docker &>/dev/null; then
  echo "ralph: docker is not installed" >&2
  exit 1
fi

if ! command -v gh &>/dev/null; then
  echo "ralph: gh is not installed (install: brew install gh)" >&2
  exit 1
fi

# --- build image ---
RALPH_DIR=${0:A:h}/../docker/ralph
HOST_UID=$(id -u)

build_image() {
  local tag=$1; shift
  if docker image inspect "$tag" &>/dev/null; then
    echo "ralph: using cached image $tag"
  else
    echo "ralph: building image $tag (this may take a minute)..."
    docker build "$@" -t "$tag" "$RALPH_DIR"
  fi
}

if [[ -n $PACKAGES ]]; then
  PKG_HASH=$(echo "$PACKAGES:$HOST_UID" | shasum -a 256 | cut -c1-12)
  IMAGE_TAG="ralph:custom-${PKG_HASH}"
  build_image "$IMAGE_TAG" \
    --build-arg "EXTRA_PACKAGES=$PACKAGES" \
    --build-arg "HOST_UID=$HOST_UID"
else
  IMAGE_TAG="ralph:uid-${HOST_UID}"
  build_image "$IMAGE_TAG" \
    --build-arg "HOST_UID=$HOST_UID"
fi

# --- resolve auth token ---
# On macOS, claude stores OAuth credentials in Keychain. Extract the
# access token and pass via env var so the container can authenticate.
KEYCHAIN_JSON=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) || {
  echo "ralph: no Claude credentials in Keychain — run 'claude' to log in first" >&2
  exit 1
}
OAUTH_TOKEN=$(echo "$KEYCHAIN_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])")

# --- resolve repo from origin remote ---
resolve_repo() {
  git remote get-url origin 2>/dev/null \
    | sed -E 's#.*github\.com[:/]##; s#\.git$##'
}

# --- parse branch from issue title [branch] prefix ---
parse_issue_branch() {
  local title=$1
  local pat='^\[([^]]+)\]'
  if [[ $title =~ $pat ]]; then
    echo "$match[1]"
  else
    echo "ralph: cannot parse branch from issue title: $title" >&2
    return 1
  fi
}

# --- parse a field from YAML frontmatter in the issue body ---
# Usage: parse_frontmatter "$body" "branch"
parse_frontmatter() {
  local body=$1 field=$2
  # Extract frontmatter block (between first two --- lines)
  local fm
  fm=$(echo "$body" | sed -n '/^---$/,/^---$/p' | sed '1d;$d')
  if [[ -z $fm ]]; then
    return 1
  fi
  # Extract field value (simple key: value parsing)
  local value
  value=$(echo "$fm" | awk -F':[[:space:]]*' -v key="$field" '$1 == key { print $2; exit }')
  if [[ -z $value ]]; then
    return 1
  fi
  echo "$value"
}

# --- process a single GitHub Issue ---
process_issue() {
  local issue_number=$1
  local repo
  repo=$(resolve_repo) || {
    echo "ralph: could not detect repo from origin remote" >&2
    return 1
  }

  # Fetch issue data
  local title body branch
  title=$(gh issue view "$issue_number" --json title -q .title --repo "$repo") || {
    echo "ralph: failed to fetch issue #$issue_number from $repo" >&2
    return 1
  }
  body=$(gh issue view "$issue_number" --json body -q .body --repo "$repo") || {
    echo "ralph: failed to fetch issue #$issue_number from $repo" >&2
    return 1
  }

  local base
  branch=$(parse_frontmatter "$body" "branch") || {
    echo "ralph: no branch in frontmatter, falling back to title" >&2
    branch=$(parse_issue_branch "$title") || return 1
  }
  base=$(parse_frontmatter "$body" "base") || true  # optional

  local work_dir
  work_dir=$(ensure_worktree "$branch" "$base")
  echo "ralph: processing issue #$issue_number on branch $branch"
  echo "ralph: using worktree at $work_dir"

  # Label in-progress
  gh issue edit "$issue_number" --remove-label "status:ready" --add-label "status:in-progress" --repo "$repo" 2>/dev/null || true

  local spec_tmpfile head_before head_after
  spec_tmpfile=$(mktemp)

  while true; do
    # Write current issue body as spec file
    echo "$body" > "$spec_tmpfile"

    # Worktree git dir mount
    local worktree_mount=()
    if [[ -f "$work_dir/.git" ]]; then
      local main_git_dir
      main_git_dir=$(git -C "$work_dir" rev-parse --git-common-dir 2>/dev/null)
      if [[ -n $main_git_dir ]]; then
        main_git_dir=${main_git_dir:A}
        worktree_mount=(-v "$main_git_dir:$main_git_dir")
      fi
    fi

    # Record HEAD before
    head_before=$(git -C "$work_dir" rev-parse HEAD 2>/dev/null || echo "none")

    # Run container (single iteration)
    echo "ralph: starting iteration (image=$IMAGE_TAG, issue=#$issue_number, model=$MODEL)"
    docker run --rm \
      -v "$work_dir:/work" \
      "${worktree_mount[@]}" \
      -v "$HOME/.gitconfig:/home/ralph/.gitconfig:ro" \
      -v "$HOME/.ssh:/home/ralph/.ssh:ro" \
      -e "PUSH=$PUSH" \
      -v "$spec_tmpfile:/tmp/spec.md" \
      -e "PROMPT_FILE=/tmp/spec.md" \
      -e "MODEL=$MODEL" \
      -e "GIT_USER=$GIT_USER" \
      -e "GIT_EMAIL=$GIT_EMAIL" \
      -e "CLAUDE_CODE_OAUTH_TOKEN=$OAUTH_TOKEN" \
      "$IMAGE_TAG" || {
        echo "ralph: container failed for issue #$issue_number" >&2
        gh issue edit "$issue_number" --remove-label "status:in-progress" --add-label "status:needs-attention" --repo "$repo" 2>/dev/null || true
        rm -f "$spec_tmpfile"
        return 1
      }

    # Check if work was done
    head_after=$(git -C "$work_dir" rev-parse HEAD 2>/dev/null || echo "none")

    if [[ $head_before == $head_after ]]; then
      # No commit — all tasks complete
      echo "ralph: no commit made, marking issue #$issue_number done"
      gh issue edit "$issue_number" --remove-label "status:in-progress" --add-label "status:done" --repo "$repo" 2>/dev/null || true
      rm -f "$spec_tmpfile"
      break
    fi

    # Update issue body from spec file (container may have checked off tasks)
    body=$(<"$spec_tmpfile")
    gh issue edit "$issue_number" --body "$body" --repo "$repo" 2>/dev/null || true
    echo "ralph: iteration complete, updated issue #$issue_number"

    # Optional push
    if (( PUSH )); then
      git -C "$work_dir" push 2>/dev/null || true
    fi
  done
}

# --- ensure worktree exists for branch ---
ensure_worktree() {
  local branch=$1
  local base_branch=${2:-}  # optional, defaults to remote HEAD
  local repo_root sanitized_branch wt_path remote
  repo_root=$(git rev-parse --show-toplevel)
  sanitized_branch=${branch//\//-}
  wt_path="${repo_root:h}/${repo_root:t}-${sanitized_branch}"

  # Check if worktree already exists for this branch
  local porcelain line wt_dir="" wt_branch=""
  porcelain=$(git worktree list --porcelain)
  porcelain+=$'\n'
  while IFS= read -r line; do
    if [[ $line == "worktree "* ]]; then
      wt_dir=${line#worktree }
    elif [[ $line == "branch "* ]]; then
      wt_branch=${line#branch refs/heads/}
    elif [[ -z $line ]]; then
      if [[ $wt_branch == $branch ]]; then
        echo "$wt_dir"
        return 0
      fi
      wt_dir="" wt_branch=""
    fi
  done <<< "$porcelain"

  # Determine remote (optional — purely local repos have none)
  if git remote | grep -qx upstream; then
    remote=upstream
  elif git remote | grep -qx origin; then
    remote=origin
  fi

  # Determine default branch name (must be a valid local ref)
  local default_branch
  if [[ -n $remote ]]; then
    default_branch=$(git symbolic-ref "refs/remotes/${remote}/HEAD" 2>/dev/null | sed "s|refs/remotes/${remote}/||") || true
  fi
  if [[ -z $default_branch ]] || ! git rev-parse --verify "$default_branch" &>/dev/null; then
    default_branch=$(git symbolic-ref --short HEAD 2>/dev/null) || default_branch=HEAD
  fi

  # Override default branch with explicit base if provided
  if [[ -n $base_branch ]]; then
    default_branch=$base_branch
  fi

  # Create worktree: track remote branch if it exists, else branch from default
  if [[ -n $remote ]] && git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" &>/dev/null; then
    git worktree add --track -b "$branch" "$wt_path" "${remote}/${branch}" >&2
  else
    git worktree add -b "$branch" "$wt_path" "$default_branch" >&2
  fi

  echo "$wt_path"
}

# --- configure git inside container ---
GIT_USER=$(git config user.name 2>/dev/null || echo "ralph")
GIT_EMAIL=$(git config user.email 2>/dev/null || echo "ralph@localhost")


# --- issue mode ---
if [[ -n $ISSUE_NUMBER ]]; then
  process_issue "$ISSUE_NUMBER"
  exit $?
fi

# --- poll mode ---
if (( POLL )); then
  REPO=$(resolve_repo) || {
    echo "ralph: could not detect repo from origin remote" >&2
    exit 1
  }

  POLL_DEADLINE=0
  if (( TIMEOUT > 0 )); then
    POLL_DEADLINE=$(( EPOCHSECONDS + TIMEOUT ))
  fi

  trap 'printf "\n"; echo "ralph: poll interrupted"; exit 0' INT TERM

  local last_was_idle=0
  local timestamp

  while true; do
    # Check deadline
    if (( POLL_DEADLINE > 0 )) && (( EPOCHSECONDS >= POLL_DEADLINE )); then
      (( last_was_idle )) && printf "\n"
      echo "ralph: poll timeout reached"
      break
    fi

    # Fetch ready issues
    issues_json=$(gh issue list --label "spec,status:ready" --author "@me" --repo "$REPO" --json number,title 2>/dev/null) || {
      (( last_was_idle )) && printf "\n"
      echo "ralph: failed to list issues from $REPO" >&2
      last_was_idle=0
      sleep "$INTERVAL"
      continue
    }

    # Parse issue numbers
    issue_numbers=$(echo "$issues_json" | python3 -c "
import sys, json
issues = json.load(sys.stdin)
for i in issues:
    print(i['number'])
" 2>/dev/null) || true

    if [[ -n $issue_numbers ]]; then
      (( last_was_idle )) && printf "\n"
      last_was_idle=0
      while IFS= read -r num; do
        echo "ralph: found ready issue #$num"
        process_issue "$num" || true
      done <<< "$issue_numbers"
    else
      timestamp=$(strftime "%H:%M:%S" "$EPOCHSECONDS")
      printf "\rralph: no ready issues found (last checked at %s)%s" "$timestamp" $'\e[K'
      last_was_idle=1
    fi

    # Check deadline before sleeping
    if (( POLL_DEADLINE > 0 )) && (( EPOCHSECONDS >= POLL_DEADLINE )); then
      (( last_was_idle )) && printf "\n"
      echo "ralph: poll timeout reached"
      break
    fi

    sleep "$INTERVAL"
  done
  exit 0
fi

# --- no mode specified ---
echo "ralph: no mode specified. Use --issue <number> or --poll" >&2
usage 2
