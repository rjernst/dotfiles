#!/usr/bin/env zsh
# ralph — Dockerized AI coding loop
#
# Repeatedly invokes Claude Code inside a Docker container. Each iteration
# gets fresh context, reads the prompt file + git history, implements the
# next task, commits, and exits. The entrypoint loop restarts the agent.
#
# Usage: ralph [options] [max-iterations]
#
# Options:
#   --packages "pkg ..."  Extra apt packages baked into image
#   --push                Git push after each iteration
#   --prompt <file>       Prompt file (overrides .ralph/specs/ discovery)
#   --model <model>       Claude model (default: sonnet)
#   --timeout <duration>  Watch for specs up to <duration> (e.g. 30m, 4h, 1d)
#   -h, --help            Show usage
set -e
zmodload zsh/stat

SELF=${0:A}

usage() {
  sed -n '/^# Usage:/,/^[^#]/p' "$SELF" | sed -n 's/^# \{0,1\}//p'
  exit "${1:-0}"
}

parse_duration() {
  local input=$1
  if [[ -z $input ]]; then
    echo "ralph: invalid duration: empty string" >&2
    exit 2
  fi
  local num suffix
  if [[ $input =~ '^([0-9]+)([smhd]?)$' ]]; then
    num=$match[1]
    suffix=$match[2]
  else
    echo "ralph: invalid duration: $input" >&2
    exit 2
  fi
  case $suffix in
    s|'') echo $(( num )) ;;
    m)    echo $(( num * 60 )) ;;
    h)    echo $(( num * 3600 )) ;;
    d)    echo $(( num * 86400 )) ;;
  esac
}

# --- defaults ---
PROMPT_FILE=""
PACKAGES=""
PUSH=0
TIMEOUT=0
MODEL=sonnet
MAX_ITERATIONS=0

# --- parse args ---
while [[ $# -gt 0 ]]; do
  case $1 in
    --packages)
      PACKAGES=$2; shift 2 ;;
    --push)
      PUSH=1; shift ;;
    --prompt)
      PROMPT_FILE=$2; shift 2 ;;
    --model)
      MODEL=$2; shift 2 ;;
    --timeout)
      TIMEOUT=$(parse_duration "$2"); shift 2 ;;
    -h|--help)
      usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2; usage 1 ;;
    *)
      MAX_ITERATIONS=$1; shift ;;
  esac
done

if (( TIMEOUT > 0 )) && [[ -n $PROMPT_FILE ]]; then
  echo "ralph: --timeout and --prompt cannot be used together" >&2
  exit 2
fi

if ! command -v docker &>/dev/null; then
  echo "ralph: docker is not installed" >&2
  exit 1
fi

if (( TIMEOUT > 0 )) && ! command -v fswatch &>/dev/null; then
  echo "ralph: fswatch is required for --timeout (install: brew install fswatch)" >&2
  exit 1
fi

# --- build image ---
RALPH_DIR=${0:A:h}/../docker/ralph
HOST_UID=$(id -u)

build_image() {
  local tag=$1; shift
  if docker image inspect "$tag" &>/dev/null; then
    echo "ralph: using cached image $tag"
  else
    echo "ralph: building image $tag (this may take a minute)..."
    docker build "$@" -t "$tag" "$RALPH_DIR"
  fi
}

if [[ -n $PACKAGES ]]; then
  PKG_HASH=$(echo "$PACKAGES:$HOST_UID" | shasum -a 256 | cut -c1-12)
  IMAGE_TAG="ralph:custom-${PKG_HASH}"
  build_image "$IMAGE_TAG" \
    --build-arg "EXTRA_PACKAGES=$PACKAGES" \
    --build-arg "HOST_UID=$HOST_UID"
else
  IMAGE_TAG="ralph:uid-${HOST_UID}"
  build_image "$IMAGE_TAG" \
    --build-arg "HOST_UID=$HOST_UID"
fi

# --- resolve auth token ---
# On macOS, claude stores OAuth credentials in Keychain. Extract the
# access token and pass via env var so the container can authenticate.
KEYCHAIN_JSON=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) || {
  echo "ralph: no Claude credentials in Keychain — run 'claude' to log in first" >&2
  exit 1
}
OAUTH_TOKEN=$(echo "$KEYCHAIN_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])")

# --- parse branch from prompt frontmatter ---
parse_branch() {
  sed -n '/^$/q; /^#/q; s/^branch: *//p' "$1" | head -1
}

# --- ensure worktree exists for branch ---
ensure_worktree() {
  local branch=$1
  local repo_root sanitized_branch wt_path remote
  repo_root=$(git rev-parse --show-toplevel)
  sanitized_branch=${branch//\//-}
  wt_path="${repo_root:h}/${repo_root:t}-${sanitized_branch}"

  # Check if worktree already exists for this branch
  local porcelain line wt_dir="" wt_branch=""
  porcelain=$(git worktree list --porcelain)
  porcelain+=$'\n'
  while IFS= read -r line; do
    if [[ $line == "worktree "* ]]; then
      wt_dir=${line#worktree }
    elif [[ $line == "branch "* ]]; then
      wt_branch=${line#branch refs/heads/}
    elif [[ -z $line ]]; then
      if [[ $wt_branch == $branch ]]; then
        echo "$wt_dir"
        return 0
      fi
      wt_dir="" wt_branch=""
    fi
  done <<< "$porcelain"

  # Determine remote
  if git remote | grep -qx upstream; then
    remote=upstream
  elif git remote | grep -qx origin; then
    remote=origin
  else
    echo "ralph: no remote found" >&2
    return 1
  fi

  # Create worktree: track remote branch if it exists, else branch from main
  if git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" &>/dev/null; then
    git worktree add --track -b "$branch" "$wt_path" "${remote}/${branch}" >&2
  else
    git worktree add -b "$branch" "$wt_path" main >&2
  fi

  echo "$wt_path"
}

PWD_ABS=${PWD:A}

# --- completed spec tracking ---
typeset -A completed_specs
WORK_DONE=0
COMPLETED_FILE="$PWD_ABS/.ralph/.completed"

# Load persisted completed specs
if [[ -f $COMPLETED_FILE ]]; then
  while IFS=$'\t' read -r spec_path spec_mtime; do
    completed_specs[$spec_path]=$spec_mtime
  done < "$COMPLETED_FILE"
fi

save_completed() {
  mkdir -p "${COMPLETED_FILE:h}"
  : > "$COMPLETED_FILE"
  for spec_path in ${(k)completed_specs}; do
    printf '%s\t%s\n' "$spec_path" "${completed_specs[$spec_path]}" >> "$COMPLETED_FILE"
  done
}

# --- process specs ---
process_specs() {
  WORK_DONE=0
  local SPEC_ABS SPEC_REL BRANCH WORK_DIR HEAD_BEFORE HEAD_AFTER

  for SPEC_ABS in "$@"; do
    # Check if spec is already completed (mtime unchanged)
    local current_mtime
    zstat -A current_mtime +mtime "$SPEC_ABS"
    current_mtime=$current_mtime[1]
    if [[ -n ${completed_specs[$SPEC_ABS]:-} ]] && [[ ${completed_specs[$SPEC_ABS]} == $current_mtime ]]; then
      echo "ralph: skipping completed spec ${SPEC_ABS#"$PWD_ABS"/}"
      continue
    fi

    SPEC_REL=${SPEC_ABS#"$PWD_ABS"/}

    # --- parse branch: directive ---
    BRANCH=$(parse_branch "$SPEC_ABS")
    if [[ -z $BRANCH ]]; then
      echo "ralph: skipping $SPEC_REL — missing required 'branch:' directive" >&2
      continue
    fi

    # --- worktree from branch: directive ---
    WORK_DIR=$(ensure_worktree "$BRANCH")
    mkdir -p "$WORK_DIR/${SPEC_REL:h}"
    cp "$SPEC_ABS" "$WORK_DIR/$SPEC_REL"
    echo "ralph: using worktree at $WORK_DIR for branch $BRANCH"

    # --- worktree support ---
    WORKTREE_MOUNT=()
    if [[ -f "$WORK_DIR/.git" ]]; then
      MAIN_GIT_DIR=$(git -C "$WORK_DIR" rev-parse --git-common-dir 2>/dev/null)
      if [[ -n $MAIN_GIT_DIR ]]; then
        MAIN_GIT_DIR=${MAIN_GIT_DIR:A}
        WORKTREE_MOUNT=(-v "$MAIN_GIT_DIR:$MAIN_GIT_DIR")
        echo "ralph: detected worktree, mounting $MAIN_GIT_DIR"
      fi
    fi

    # --- record HEAD before ---
    HEAD_BEFORE=$(git -C "$WORK_DIR" rev-parse HEAD 2>/dev/null || echo "none")

    # --- run container ---
    echo "ralph: starting (image=$IMAGE_TAG, prompt=$SPEC_REL, model=$MODEL)"
    docker run --rm $TTY_FLAGS \
      -v "$WORK_DIR:/work" \
      "${WORKTREE_MOUNT[@]}" \
      -v "$HOME/.gitconfig:/home/ralph/.gitconfig:ro" \
      -v "$HOME/.ssh:/home/ralph/.ssh:ro" \
      -e "MAX_ITERATIONS=$MAX_ITERATIONS" \
      -e "PUSH=$PUSH" \
      -e "PROMPT_FILE=$SPEC_REL" \
      -e "MODEL=$MODEL" \
      -e "GIT_USER=$GIT_USER" \
      -e "GIT_EMAIL=$GIT_EMAIL" \
      -e "CLAUDE_CODE_OAUTH_TOKEN=$OAUTH_TOKEN" \
      "$IMAGE_TAG" || {
        echo "ralph: warning — docker failed for $SPEC_REL, continuing" >&2
      }

    # --- check if work was done ---
    HEAD_AFTER=$(git -C "$WORK_DIR" rev-parse HEAD 2>/dev/null || echo "none")
    if [[ $HEAD_BEFORE == $HEAD_AFTER ]]; then
      # No commit produced — mark spec as completed
      local completed_mtime
      zstat -A completed_mtime +mtime "$SPEC_ABS"
      completed_specs[$SPEC_ABS]=$completed_mtime[1]
      save_completed
    else
      WORK_DONE=1
    fi
  done
}

# --- resolve spec files ---
if [[ -n $PROMPT_FILE ]]; then
  # Explicit --prompt: single-file mode (existing behavior)
  if [[ ! -f "$PROMPT_FILE" ]]; then
    echo "ralph: prompt file not found: $PROMPT_FILE" >&2
    exit 1
  fi
  PROMPT_ABS=${PROMPT_FILE:A}
  SPECS=("$PROMPT_ABS")
else
  # Auto-discover specs from .ralph/specs/
  SPECS=(.ralph/specs/*.md(N))
  if [[ ${#SPECS} -eq 0 ]] && (( TIMEOUT == 0 )); then
    echo "ralph: no spec files found in .ralph/specs/" >&2
    echo "Create a spec or use --prompt <file>" >&2
    exit 1
  fi
  # Resolve to absolute paths
  SPECS=("${SPECS[@]:A}")
fi

# --- configure git inside container ---
GIT_USER=$(git config user.name 2>/dev/null || echo "ralph")
GIT_EMAIL=$(git config user.email 2>/dev/null || echo "ralph@localhost")

# --- process each spec ---
TTY_FLAGS="-i"
[[ -t 1 ]] && TTY_FLAGS="-it"

if (( TIMEOUT > 0 )); then
  # --- watch loop ---
  mkdir -p .ralph/specs
  DEADLINE=$(( EPOCHSECONDS + TIMEOUT ))
  while true; do
    SPECS=("$PWD_ABS"/.ralph/specs/*.md(N))
    if (( ${#SPECS} > 0 )); then
      process_specs "${SPECS[@]}"
      if (( WORK_DONE )); then
        DEADLINE=$(( EPOCHSECONDS + TIMEOUT ))
      fi
    fi
    REMAINING=$(( DEADLINE - EPOCHSECONDS ))
    if (( REMAINING <= 0 )); then
      echo "ralph: timeout expired, no pending work found"
      break
    fi
    echo "ralph: watching .ralph/specs/ (${REMAINING}s remaining)"
    fswatch -1 --latency 1 .ralph/specs/ &
    FSWATCH_PID=$!
    ( sleep $REMAINING && kill $FSWATCH_PID 2>/dev/null ) &
    TIMER_PID=$!
    FSWATCH_EXIT=0
    wait $FSWATCH_PID 2>/dev/null || FSWATCH_EXIT=$?
    kill $TIMER_PID 2>/dev/null || true
    wait $TIMER_PID 2>/dev/null || true
    if (( FSWATCH_EXIT != 0 )); then
      echo "ralph: timeout expired, no pending work found"
      break
    fi
  done
else
  # --- single-pass mode ---
  process_specs "${SPECS[@]}"
fi
