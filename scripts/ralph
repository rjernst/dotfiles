#!/usr/bin/env zsh
# ralph — Dockerized AI coding loop
#
# Repeatedly invokes Claude Code inside a Docker container. Each iteration
# gets fresh context, reads the prompt file + git history, implements the
# next task, commits, and exits. The entrypoint loop restarts the agent.
#
# Usage: ralph [options] [max-iterations]
#
# Options:
#   --packages "pkg ..."  Extra apt packages baked into image
#   --push                Git push after each iteration
#   --prompt <file>       Prompt file (default: PROMPT.md)
#   --model <model>       Claude model (default: sonnet)
#   -h, --help            Show usage
set -e

SELF=${0:A}

usage() {
  sed -n '/^# Usage:/,/^[^#]/p' "$SELF" | sed -n 's/^# \{0,1\}//p'
  exit "${1:-0}"
}

# --- defaults ---
PROMPT_FILE=PROMPT.md
PACKAGES=""
PUSH=0
MODEL=sonnet
MAX_ITERATIONS=0

# --- parse args ---
while [[ $# -gt 0 ]]; do
  case $1 in
    --packages)
      PACKAGES=$2; shift 2 ;;
    --push)
      PUSH=1; shift ;;
    --prompt)
      PROMPT_FILE=$2; shift 2 ;;
    --model)
      MODEL=$2; shift 2 ;;
    -h|--help)
      usage 0 ;;
    -*)
      echo "Unknown option: $1" >&2; usage 1 ;;
    *)
      MAX_ITERATIONS=$1; shift ;;
  esac
done

if ! command -v docker &>/dev/null; then
  echo "ralph: docker is not installed" >&2
  exit 1
fi

# --- build image ---
RALPH_DIR=${0:A:h}/../docker/ralph
HOST_UID=$(id -u)

build_image() {
  local tag=$1; shift
  if docker image inspect "$tag" &>/dev/null; then
    echo "ralph: using cached image $tag"
  else
    echo "ralph: building image $tag (this may take a minute)..."
    docker build "$@" -t "$tag" "$RALPH_DIR"
  fi
}

if [[ -n $PACKAGES ]]; then
  PKG_HASH=$(echo "$PACKAGES:$HOST_UID" | shasum -a 256 | cut -c1-12)
  IMAGE_TAG="ralph:custom-${PKG_HASH}"
  build_image "$IMAGE_TAG" \
    --build-arg "EXTRA_PACKAGES=$PACKAGES" \
    --build-arg "HOST_UID=$HOST_UID"
else
  IMAGE_TAG="ralph:uid-${HOST_UID}"
  build_image "$IMAGE_TAG" \
    --build-arg "HOST_UID=$HOST_UID"
fi

# --- resolve auth token ---
# On macOS, claude stores OAuth credentials in Keychain. Extract the
# access token and pass via env var so the container can authenticate.
KEYCHAIN_JSON=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null) || {
  echo "ralph: no Claude credentials in Keychain — run 'claude' to log in first" >&2
  exit 1
}
OAUTH_TOKEN=$(echo "$KEYCHAIN_JSON" | python3 -c "import sys,json; print(json.load(sys.stdin)['claudeAiOauth']['accessToken'])")

if [[ ! -f "$PROMPT_FILE" ]]; then
  echo "ralph: prompt file not found: $PROMPT_FILE" >&2
  echo "Create a PROMPT.md or use --prompt <file>" >&2
  exit 1
fi

# --- parse branch from prompt frontmatter ---
parse_branch() {
  sed -n '/^$/q; /^#/q; s/^branch: *//p' "$1" | head -1
}

# --- ensure worktree exists for branch ---
ensure_worktree() {
  local branch=$1
  local repo_root sanitized_branch wt_path remote
  repo_root=$(git rev-parse --show-toplevel)
  sanitized_branch=${branch//\//-}
  wt_path="${repo_root:h}/${repo_root:t}-${sanitized_branch}"

  # Check if worktree already exists for this branch
  local porcelain line wt_dir="" wt_branch=""
  porcelain=$(git worktree list --porcelain)
  porcelain+=$'\n'
  while IFS= read -r line; do
    if [[ $line == "worktree "* ]]; then
      wt_dir=${line#worktree }
    elif [[ $line == "branch "* ]]; then
      wt_branch=${line#branch refs/heads/}
    elif [[ -z $line ]]; then
      if [[ $wt_branch == $branch ]]; then
        echo "$wt_dir"
        return 0
      fi
      wt_dir="" wt_branch=""
    fi
  done <<< "$porcelain"

  # Determine remote
  if git remote | grep -qx upstream; then
    remote=upstream
  elif git remote | grep -qx origin; then
    remote=origin
  else
    echo "ralph: no remote found" >&2
    return 1
  fi

  # Create worktree: track remote branch if it exists, else branch from main
  if git ls-remote --exit-code --heads "$remote" "refs/heads/$branch" &>/dev/null; then
    git worktree add --track -b "$branch" "$wt_path" "${remote}/${branch}" >&2
  else
    git worktree add -b "$branch" "$wt_path" main >&2
  fi

  echo "$wt_path"
}

# --- resolve prompt file to absolute path relative to $PWD ---
PROMPT_ABS=${PROMPT_FILE:A}
PWD_ABS=${PWD:A}
if [[ $PROMPT_ABS != $PWD_ABS/* ]]; then
  echo "ralph: prompt file must be inside the current directory" >&2
  exit 1
fi
PROMPT_REL=${PROMPT_ABS#"$PWD_ABS"/}

# --- worktree from branch: directive ---
WORK_DIR=$PWD_ABS
BRANCH=$(parse_branch "$PROMPT_ABS")
if [[ -n $BRANCH ]]; then
  WORK_DIR=$(ensure_worktree "$BRANCH")
  mkdir -p "$WORK_DIR/${PROMPT_REL:h}"
  cp "$PROMPT_ABS" "$WORK_DIR/$PROMPT_REL"
  echo "ralph: using worktree at $WORK_DIR for branch $BRANCH"
fi

# --- configure git inside container ---
GIT_USER=$(git config user.name 2>/dev/null || echo "ralph")
GIT_EMAIL=$(git config user.email 2>/dev/null || echo "ralph@localhost")

# --- worktree support ---
# Git worktrees use a .git file pointing to the main repo's .git/worktrees/<name>.
# Mount the main .git directory so git can resolve the worktree inside the container.
WORKTREE_MOUNT=()
if [[ -f "$WORK_DIR/.git" ]]; then
  MAIN_GIT_DIR=$(git -C "$WORK_DIR" rev-parse --git-common-dir 2>/dev/null)
  if [[ -n $MAIN_GIT_DIR ]]; then
    MAIN_GIT_DIR=${MAIN_GIT_DIR:A}
    WORKTREE_MOUNT=(-v "$MAIN_GIT_DIR:$MAIN_GIT_DIR")
    echo "ralph: detected worktree, mounting $MAIN_GIT_DIR"
  fi
fi

# --- run container ---
echo "ralph: starting (image=$IMAGE_TAG, prompt=$PROMPT_REL, model=$MODEL)"
TTY_FLAGS="-i"
[[ -t 1 ]] && TTY_FLAGS="-it"
exec docker run --rm $TTY_FLAGS \
  -v "$WORK_DIR:/work" \
  "${WORKTREE_MOUNT[@]}" \
  -v "$HOME/.gitconfig:/home/ralph/.gitconfig:ro" \
  -v "$HOME/.ssh:/home/ralph/.ssh:ro" \
  -e "MAX_ITERATIONS=$MAX_ITERATIONS" \
  -e "PUSH=$PUSH" \
  -e "PROMPT_FILE=$PROMPT_REL" \
  -e "MODEL=$MODEL" \
  -e "GIT_USER=$GIT_USER" \
  -e "GIT_EMAIL=$GIT_EMAIL" \
  -e "CLAUDE_CODE_OAUTH_TOKEN=$OAUTH_TOKEN" \
  "$IMAGE_TAG"
