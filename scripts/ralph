#!/bin/sh
# Resolve symlinks so ~/bin/ralph -> .dotfiles/scripts/ralph works
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  case "$SCRIPT" in /*) ;; *) SCRIPT="$SCRIPT_DIR/$SCRIPT";; esac
done
DOTFILES_DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
PYTHONPATH="${DOTFILES_DIR}/tools/ralph/src:${DOTFILES_DIR}/tools/libs" exec python3 -m ralph "$@"
