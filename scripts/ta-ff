#!/usr/bin/env zsh

# ta-ff — Fork and focus
# Creates a new worktree + workspace in one command.
# "Fork" a branch off main and "focus" by opening a tmux session in it.

set -eu

usage() {
  echo "usage: ta ff <branch> [prompt] [--remote <remote>] [--cmd <command>]"
  echo "       ta ff --from-worktree <branch> [--cmd <command>]"
  echo ""
  echo "Fork a branch off main, create a worktree and workspace, then attach."
  echo ""
  echo "Options:"
  echo "  --remote <remote>   Remote to push to (default: upstream or origin)"
  echo "  --cmd <command>     Command to run in the workspace session"
  echo "  --from-worktree     Skip branch/worktree creation, just create workspace"
  exit 2
}

if [[ $# -eq 0 ]]; then
  usage
fi

# Allow overriding sub-script paths for testing
script_dir="${0:A:h}"
: ${TA_WT_CMD:=${script_dir}/ta-wt}
: ${TA_WORKSPACE_CMD:=${script_dir}/ta-workspace}

# --- parse arguments ---
branch=""
prompt=""
remote=""
send_cmd=""
from_worktree=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --remote) remote="$2"; shift 2 ;;
    --remote=*) remote="${1#--remote=}"; shift ;;
    --cmd) send_cmd="$2"; shift 2 ;;
    --cmd=*) send_cmd="${1#--cmd=}"; shift ;;
    --from-worktree) from_worktree=true; shift ;;
    -*)
      echo "ta: unknown option '$1'" >&2
      exit 2
      ;;
    *)
      if [[ -z "$branch" ]]; then
        branch="$1"
      elif [[ -z "$prompt" ]]; then
        prompt="$1"
      else
        echo "ta: unexpected argument '$1'" >&2
        exit 2
      fi
      shift
      ;;
  esac
done

if [[ -z "$branch" ]]; then
  echo "ta: branch name required" >&2
  exit 2
fi

# If a prompt is provided and no --cmd, build agent command
if [[ -n "$prompt" && -z "$send_cmd" ]]; then
  send_cmd="claude ${(qq)prompt}"
fi

# --- from-worktree mode: just create workspace and attach ---
if [[ "$from_worktree" == true ]]; then
  # Verify the worktree exists
  local wt_json
  wt_json="$(zsh "$TA_WT_CMD" list --json 2>/dev/null)" || {
    echo "ta: failed to list worktrees" >&2
    exit 1
  }
  local wt_path
  wt_path="$(echo "$wt_json" | jq -r --arg b "$branch" '.[] | select(.branch == $b) | .path' 2>/dev/null)" || true
  if [[ -z "$wt_path" || "$wt_path" == "null" ]]; then
    echo "ta: no worktree found for branch '$branch'" >&2
    exit 1
  fi

  # Create workspace and attach
  local ws_args=("$branch")
  if [[ -n "$send_cmd" ]]; then
    ws_args+=(--cmd "$send_cmd")
  fi
  zsh "$TA_WORKSPACE_CMD" create "${ws_args[@]}"
  zsh "$TA_WORKSPACE_CMD" attach "$branch"
  exit 0
fi

# --- full fork-and-focus flow ---

# Check if branch already exists as a worktree
local wt_json
wt_json="$(zsh "$TA_WT_CMD" list --json 2>/dev/null)" || wt_json="[]"
local existing_path
existing_path="$(echo "$wt_json" | jq -r --arg b "$branch" '.[] | select(.branch == $b) | .path' 2>/dev/null)" || true

if [[ -n "$existing_path" && "$existing_path" != "null" ]]; then
  echo "ta: branch '$branch' already has a worktree at $existing_path"
  echo "ta: creating workspace and attaching..."

  local ws_args=("$branch")
  if [[ -n "$send_cmd" ]]; then
    ws_args+=(--cmd "$send_cmd")
  fi
  zsh "$TA_WORKSPACE_CMD" create "${ws_args[@]}"
  zsh "$TA_WORKSPACE_CMD" attach "$branch"
  exit 0
fi

# Determine remote
if [[ -z "$remote" ]]; then
  if git remote | grep -qx upstream; then
    remote="upstream"
  elif git remote | grep -qx origin; then
    remote="origin"
  else
    echo "ta: no remote found (tried upstream, origin)" >&2
    exit 1
  fi
fi

# Generate worktree path
local repo_root repo_name sanitized_branch wt_path
repo_root="$(git rev-parse --show-toplevel)"
repo_name="${repo_root:t}"
sanitized_branch="${branch//\//-}"
wt_path="${repo_root:h}/${repo_name}-${sanitized_branch}"

if [[ -e "$wt_path" ]]; then
  echo "ta: path already exists: $wt_path" >&2
  exit 1
fi

# 1. Create worktree with new branch from main
echo "ta: creating branch '$branch' from main..."
git worktree add -b "$branch" "$wt_path" main

# 2. Push to remote
echo "ta: pushing '$branch' to $remote..."
git -C "$wt_path" push -u "$remote" "$branch"

# 3. Create workspace
local ws_args=("$branch")
if [[ -n "$send_cmd" ]]; then
  ws_args+=(--cmd "$send_cmd")
fi
zsh "$TA_WORKSPACE_CMD" create "${ws_args[@]}"

# 4. Attach
zsh "$TA_WORKSPACE_CMD" attach "$branch"
