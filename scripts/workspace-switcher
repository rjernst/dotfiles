#!/usr/bin/env zsh
set -euo pipefail

width="${1:-50%}"
height="${2:-40%}"

# Self-re-exec inside a tmux popup if not already in one
if [[ -z "${WORKSPACE_SWITCHER_INSIDE_POPUP:-}" ]]; then
  # Capture original pane path before entering the popup
  orig_pane_path=$(tmux display-message -p '#{pane_current_path}')
  exec tmux popup -xC -yC -w"$width" -h"$height" -E \
    "WORKSPACE_SWITCHER_INSIDE_POPUP=1 ORIG_PANE_PATH='$orig_pane_path' $0 $width $height"
fi

current_session=$(tmux display-message -p '#{session_name}')
export CURRENT_SESSION="$current_session"

# Collapse state file — unique per tmux server
collapse_file="/tmp/tmux-workspace-collapsed-$(tmux display-message -p '#{pid}')"

# Build header
header="enter switch │ tab collapse │ ctrl-a agent loop │ ctrl-d kill │ esc close
● current  ◉ attached  ○ detached"

# Run fzf with grouped display
# workspace-switcher-list accepts raw fzf field values and resolves group keys internally
selection=$(workspace-switcher-list "$collapse_file" | fzf \
  --ansi \
  --with-nth=2.. \
  --delimiter=$'\t' \
  --header="$header" \
  --border=rounded \
  --no-info \
  --reverse \
  --prompt="  " \
  --pointer="▶" \
  --bind "tab:execute-silent(workspace-switcher-list \"$collapse_file\" {1})+reload(workspace-switcher-list \"$collapse_file\")" \
  --bind "ctrl-d:execute-silent(f={1}; if [ \"\${f%%:*}\" = GROUP ]; then exit 0; fi; if [ \"\$f\" = \"$current_session\" ]; then exit 0; fi; tmux kill-session -t \"\$f\")+reload(workspace-switcher-list \"$collapse_file\")" \
  --bind "ctrl-a:become(echo AGENT_LOOP)" \
) || exit 0

# Extract raw session name or group key (field 1)
target="${selection%%$'\t'*}"

# If it's a group header, toggle collapse and re-run
if [[ "$target" == GROUP:* ]]; then
  group_key="${target#GROUP:}"
  workspace-switcher-list "$collapse_file" "$group_key" > /dev/null
  exec "$0" "$width" "$height"
fi

# Agent-loop creation (Ctrl-A)
if [[ "$target" == "AGENT_LOOP" ]]; then
  git_root=$(git -C "${ORIG_PANE_PATH:-$PWD}" rev-parse --show-toplevel 2>/dev/null) || {
    tmux display-message "workspace-switcher: not in a git repository"
    exec "$0" "$width" "$height"
  }
  project=$(basename "$git_root")
  session_name="al-$project"
  if tmux has-session -t "$session_name" 2>/dev/null; then
    tmux switch-client -t "$session_name"
  else
    tmux new-session -d -s "$session_name" -c "$git_root"
    if command -v ralph &>/dev/null; then
      tmux send-keys -t "$session_name" "ralph --timeout 4h" Enter
    fi
    tmux switch-client -t "$session_name"
  fi
  exit 0
fi

# Switch if different from current
if [[ -n "$target" && "$target" != "$current_session" ]]; then
  tmux switch-client -t "$target"
fi
