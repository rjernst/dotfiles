#!/usr/bin/env zsh
set -euo pipefail

width="${1:-60%}"
height="${2:-50%}"

# Self-re-exec inside a tmux popup if not already in one
if [[ -z "${WORKSPACE_SWITCHER_INSIDE_POPUP:-}" ]]; then
  exec tmux popup -xC -yC -w"$width" -h"$height" -E \
    "WORKSPACE_SWITCHER_INSIDE_POPUP=1 $0 $width $height"
fi

current_session=$(tmux display-message -p '#{session_name}')

# Build session list: tab-separated lines for fzf
lines=()
while IFS=$'\t' read -r name windows attached; do
  # Skip transient popup sessions
  [[ "$name" == "popup" || "$name" == "popover" ]] && continue

  # Determine indicator
  if [[ "$name" == "$current_session" ]]; then
    indicator="●"
  elif (( attached > 0 )); then
    indicator="◉"
  else
    indicator="○"
  fi

  # Get working directory basename from the active pane
  pane_path=$(tmux display-message -t "$name" -p '#{pane_current_path}' 2>/dev/null || echo "")
  dir_name="${pane_path:t}"
  [[ -z "$dir_name" ]] && dir_name="-"

  # Strip wt- prefix for display
  display_name="${name#wt-}"

  # Pluralize windows
  if (( windows == 1 )); then
    win_label="1 window"
  else
    win_label="$windows windows"
  fi

  # raw_name<TAB>indicator  display_name<TAB>dir<TAB>windows
  lines+=("${name}\t${indicator}  ${display_name}\t${dir_name}\t${win_label}")
done < <(tmux list-sessions -F '#{session_name}	#{session_windows}	#{session_attached}' | sort)

# Nothing to show
(( ${#lines[@]} == 0 )) && exit 0

# Run fzf
selection=$(printf '%b\n' "${lines[@]}" | fzf \
  --with-nth=2.. \
  --delimiter=$'\t' \
  --header="  Switch Session  ● current  ◉ attached  ○ detached" \
  --border=rounded \
  --no-info \
  --reverse \
  --prompt="  " \
  --pointer="▶" \
) || exit 0

# Extract raw session name (field 1)
target="${selection%%$'\t'*}"

# Switch if different from current
if [[ -n "$target" && "$target" != "$current_session" ]]; then
  tmux switch-client -t "$target"
fi
