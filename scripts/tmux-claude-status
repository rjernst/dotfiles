#!/bin/sh
# tmux-claude-status — toggle tmux status lines based on active pane command.
# Called from automatic-rename-format via #(). Operates entirely via side effects.
# Queries the focused pane directly (not via args) to avoid multi-window conflicts.

pane_cmd=$(tmux display-message -p '#{pane_current_command}')

# Detect if any process in the focused pane is running as root.
# #{pane_pid} is the initial shell — after sudo/su the root process
# is a child. Check all processes on the pane's TTY instead.
pane_tty=$(tmux display-message -p '#{pane_tty}')
if ps -t "${pane_tty#/dev/}" -o uid= 2>/dev/null | tr -d ' ' | grep -q '^0$'; then
    want_bg=colour1
    want_fg=colour7
else
    want_bg=colour2
    want_fg=colour0
fi

# Only update if changed — unconditional set-option -g can trigger
# cascading status refreshes that lock up tmux.
if [ "$(tmux show-option -gqv @host_bg)" != "$want_bg" ]; then
    tmux set-option -g @host_bg "$want_bg"
    tmux set-option -g @host_fg "$want_fg"
fi

if [ "$pane_cmd" = "claude" ]; then
    # Get pane working directory and replace $HOME with ~
    pane_path=$(tmux display-message -p '#{pane_current_path}')
    case "$pane_path" in
        "$HOME"*) display_path="~${pane_path#"$HOME"}" ;;
        *) display_path="$pane_path" ;;
    esac

    # Honeycomb right U+E0CC to cap the right edge
    right=$(printf '\356\203\214')
    format="#[fg=colour7,bg=colour8] ${display_path} #[fg=colour8,bg=default]${right}"

    # Enable two status lines if not already
    current_status=$(tmux show-option -qv status)
    if [ "$current_status" != "2" ]; then
        # Move the normal bar to status-format[1] (top) and use [0] (bottom)
        # for the path. tmux array options are overridden as a whole at session
        # scope, so both indices must be set explicitly.
        tmux set-option 'status-format[1]' "$(tmux show-option -gqv 'status-format[0]')"
        tmux set-option status 2
    fi

    # Update path format only if changed (avoid flicker)
    current_format=$(tmux show-option -qv 'status-format[0]')
    if [ "$current_format" != "$format" ]; then
        tmux set-option 'status-format[0]' "$format"
    fi
else
    current_status=$(tmux show-option -qv status)
    if [ "$current_status" = "2" ]; then
        # Revert to single status line. Restore status-format[0] to the
        # global default rather than unsetting — tmux array unsets are
        # unreliable and can leave a stale empty session-level array.
        tmux set-option 'status-format[0]' "$(tmux show-option -gqv 'status-format[0]')"
        tmux set-option -u 'status-format[1]'
        tmux set-option status on
    fi
fi

exit 0
